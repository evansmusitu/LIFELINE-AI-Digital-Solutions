{
	"$schema": "./node_modules/wrangler/config-schema.json",
	// Must match the Worker name in the Cloudflare dashboard, or Workers Builds fails.
	"name": "lifeline-demo-studio",
	"compatibility_date": "2026-11-15",
	// Production is served on lifeline.mftintelligence.com only. The domain must be in the same
	// Cloudflare account as the Worker; Cloudflare creates its DNS record and certificate. Each pull
	// request Preview gets its own workers.dev link, which tells search engines not to index it.
	"routes": [{ "pattern": "lifeline.mftintelligence.com", "custom_domain": true }],
	"workers_dev": false,
	"preview_urls": true,
	// The Worker script answers /api/* (the AI receptionist, video calls and counts) and the private
	// /stats page only. Every other request is a static file from the Vite build, which Cloudflare
	// serves free and without a limit.
	"main": "worker/index.ts",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		// /demos/<slug> serves dist/demos/<slug>.html (the default "auto-trailing-slash" HTML
		// handling). Unknown paths load the studio, which shows its "page not found" screen.
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*", "/stats"],
	},
	// Workers AI. Every account includes 10,000 Neurons a day, shared by all its Workers. On the
	// Workers Free plan, calls past that fail instead of being billed; on Workers Paid they are billed.
	// AI_REPLIES_PER_DAY keeps this site well inside the allowance either way.
	"ai": { "binding": "AI" },
	// ChatLimiter: message limits per minute and per day (worker/limiter.ts), so one visitor or one
	// network can't use up the day's free AI allowance. VideoCalls: starts and ends video calls and
	// keeps them inside the limits below (worker/video-calls.ts). SiteStats: the daily totals shown on
	// /stats (worker/stats.ts). The Workers Free plan only allows SQLite-backed classes.
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["ChatLimiter"] },
		{ "tag": "v2", "new_sqlite_classes": ["VideoCalls"] },
		{ "tag": "v3", "new_sqlite_classes": ["SiteStats"] },
	],
	// The Napster API key is the secret NAPSTER_API_KEY, set in Cloudflare, not here.
	"vars": {
		"AI_MODEL": "@cf/google/gemma-4-26b-a4b-it",
		// "true" lets a request pick another model from the list in worker/receptionist.ts. Previews only.
		"ALLOW_MODEL_CHOICE": "false",
		// AI replies a day for the whole site, about 25 Neurons each: 300 is about 7,500 Neurons, leaving
		// room for Previews and the account's other Workers. Past it, visitors get saved answers. "0" turns AI off.
		"AI_REPLIES_PER_DAY": "300",
		// Video calls with Tari. Created by scripts/napster-setup.mjs.
		"NAPSTER_AGENT_ID": "8c898d9e-1056-4587-8972-7dde8ea92856",
		// Total Napster spend allowed, across the live site, Previews and tests together. "0" turns calls off.
		"VIDEO_BUDGET_USD": "40",
		"VIDEO_CALLS_PER_DAY": "20",
		// Per day. Many phones on one mobile network can share an IPv4 address, so the network limit is higher.
		"VIDEO_CALLS_PER_VISITOR": "2",
		"VIDEO_CALLS_PER_NETWORK": "6",
		// Just under 3 minutes, so a full call is billed as 3 minutes (Napster bills each started minute).
		"VIDEO_CALL_SECONDS": "175",
		"VIDEO_PRICE_PER_MINUTE": "0.0583",
		// The private /stats page: SHA-256 of its passcode, from `npm run stats-passcode`. "" removes the page.
		"STATS_PASSCODE_SHA256": "9568a3b803f24b6e9533a1116bb4ebf51332c35dd7f8e7c9014f52bd42548b97",
	},
	// Worker Previews (pull request preview links) don't inherit the settings above, so they are
	// repeated here. Each Preview gets its own Durable Objects automatically. Previews use their own
	// Napster agent, so testing changed instructions never touches the live site's agent. Spend and
	// daily calls are counted from Napster's records, so they are shared with the live site.
	"previews": {
		"ai": { "binding": "AI" },
		"vars": {
			"AI_MODEL": "@cf/google/gemma-4-26b-a4b-it",
			"ALLOW_MODEL_CHOICE": "true",
			// Each Preview counts its own replies, so keep this small: Previews share the account's allowance.
			"AI_REPLIES_PER_DAY": "20",
			"NAPSTER_AGENT_ID": "bc89d6ff-e2d8-4a1e-8cf1-536f4ace96a5",
			"VIDEO_BUDGET_USD": "40",
			"VIDEO_CALLS_PER_DAY": "20",
			// Preview links are public too, and share the daily and spending limits with the live site.
			"VIDEO_CALLS_PER_VISITOR": "2",
			"VIDEO_CALLS_PER_NETWORK": "6",
			"VIDEO_CALL_SECONDS": "175",
			"VIDEO_PRICE_PER_MINUTE": "0.0583",
			"STATS_PASSCODE_SHA256": "9568a3b803f24b6e9533a1116bb4ebf51332c35dd7f8e7c9014f52bd42548b97",
		},
	},
}
