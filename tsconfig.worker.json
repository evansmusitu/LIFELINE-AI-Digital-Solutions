{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo",
    "target": "es2024",
    "lib": ["ES2024"],
    "module": "esnext",
    /* Cloudflare's runtime types come from worker/worker-configuration.d.ts (npm run cf-typegen). */
    "types": [],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["worker", "src/config/site.ts", "src/config/about.ts", "src/receptionist/protocol.ts", "src/lib/count-events.ts", "src/demos/wellness-consulting/business.ts", "src/demos/school-admissions/business.ts"]
}
